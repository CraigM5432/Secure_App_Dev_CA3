<h1>Create a New Post</h1>

<form action="/posts" method="post">
  <!-- No CSRF token included -->

  <label>Title</label><br>
  <input type="text" name="post[title]"><br><br>

  <label>Body</label><br>
  <textarea name="post[body]"></textarea><br><br>

  <!-- INSECURE: User spoofing -->
  <label>User ID (allowing impersonation of nay user)</label><br>
  <input type="text" name="post[user_id]" value="1"><br><br>

  <button type="submit">Create Post</button>
  <a href="/posts">Back to Posts</a>
</form>

