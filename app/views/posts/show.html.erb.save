<h1><%= @post.title %></h1>

<p><%= simple_format(@post.body) %></p>
<p><strong>Author:</strong> <%= @post.user.display_name %></p>

<%# ------------------------------ %>
<%# Post Owner or Admin Controls  %>
<%# ------------------------------ %>

<% if comment.user == current_user || current_user.role == "admin" %>
  <%= link_to "Delete",post_comment_path(@post, comment), data: { "turbo-method": "delete", "turbo-confirm": "Are you sure you want to delete this comment?" } %>

<% end %>

<hr>

<h2>Comments</h2>

<% @post.comments.each do |comment| %>
  <p>
    <%= simple_format(comment.body) %><br>
    <small>— <%= comment.user.display_name %></small>

    <%# Comment Owner OR Admin can delete %>
    <% if comment.user == current_user || current_user.role == "admin" %>
      |
      <%= link_to "Delete",
                  post_comment_path(@post, comment),
                  data: {
                    turbo: false,
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this comment?"
                  } %>
    <% end %>
  </p>

  <hr>
<% end %>

<h3>Add a Comment</h3>

<%= form_with model: [@post, Comment.new], local: true do |form| %>
  <p><%= form.text_area :body %></p>
  <%= form.submit "Add Comment" %>
<% end %>

<br>

<%= link_to "Back to Posts", posts_path %>

