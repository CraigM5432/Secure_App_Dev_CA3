<%= form_with(model: [@post, @comment], local: true) do |form| %>

  <% if @comment.errors.any? %>
    <ul style="color:red;">
      <% @comment.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <p>
    <%= form.label :body %><br>
    <%= form.text_area :body %>
  </p>

  <%= form.submit "Add Comment" %>

<% end %>
