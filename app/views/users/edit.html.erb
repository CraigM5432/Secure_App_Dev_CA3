<h1>Edit User (insecure)</h1>

<form action="/users/<%= @user.id %>" method="post">
  <input type="hidden" name="_method" value="patch">

  <label>Email</label><br>
  <input type="text" name="user[email]" value="<%= raw @user.email %>"><br><br>

  <label>Password (stored in plain text!)</label><br>
  <input type="text" name="user[password]" value="<%= raw @user.password %>"><br><br>

  <label>Display Name</label><br>
  <input type="text" name="user[display_name]" value="<%= raw @user.display_name %>"><br><br>

  <label>Role (insecure — attacker can set admin)</label><br>
  <input type="text" name="user[role]" value="<%= raw @user.role %>"><br><br>

  <button type="submit">Save Changes</button>
  <a href="/posts">Back to Posts</a>
</form>
